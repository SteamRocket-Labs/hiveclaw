# Hive Environment Variables
# Copy this file to .env and fill in the values

# Security
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-jwt-secret

# Secrets encryption master key (encrypts LLM API keys and channel credentials at rest)
# Generate with: openssl rand -hex 32
# Leave empty for dev mode (secrets stored in plaintext)
SECRETS_MASTER_KEY=

# Database (auto-configured by setup.sh; override for custom setups)
# For local dev, ssl=disable is required to prevent asyncpg SSL negotiation hang
DATABASE_URL=postgresql+asyncpg://clawith:clawith@localhost:5432/clawith?ssl=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# Feishu OAuth (optional, for SSO login)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://localhost:3000/auth/feishu/callback
FEISHU_CLI_ENABLED=false
FEISHU_CLI_BIN=lark-cli
FEISHU_CLI_TIMEOUT_SECONDS=30
FEISHU_CLI_IDENTITY=bot

# Agent workspace data directory.
# Default: local host -> ~/.hive/data/agents ; container runtime -> /data/agents
# AGENT_DATA_DIR=

# Office editing (OfficeCLI agent tools + ONLYOFFICE WYSIWYG editor)
OFFICECLI_BIN=officecli
OFFICECLI_SHA256=
OFFICECLI_TIMEOUT_SECONDS=45
OFFICECLI_DOWNLOAD_URL=
ONLYOFFICE_DOCS_URL=http://localhost:8082
ONLYOFFICE_INTERNAL_DOCS_URL=http://onlyoffice-documentserver
ONLYOFFICE_JWT_SECRET=change-me-onlyoffice-secret
ONLYOFFICE_DOWNLOAD_TOKEN_EXPIRE_SECONDS=300
ONLYOFFICE_PORT=8082

# Hindsight memory backend (optional read-side accelerator for agent memory)
# Leave HINDSIGHT_ENABLED=false until canary rollout.
# Phase A deployment: single Hindsight instance + global key; per-tenant isolation
# via bank_id = "hive-t{tenant_hex}-a{agent_hex}". Phase B (per-tenant PG schema)
# waits for upstream vectorize-io/hindsight PR #855 to merge.
HINDSIGHT_URL=
HINDSIGHT_API_KEY=
HINDSIGHT_ENABLED=false
HINDSIGHT_TIMEOUT_SECONDS=10

TAVILY_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
XCRAWL_API_KEY=
